{
  "manifest_version": 3,
  "name": "Anlık Dublaj",
  "version": "1.2.0",
  "description": "Sekmedeki videoların sesini Gemini Live Translate API ile gerçek zamanlı olarak seçtiğin dile çevirir ve seslendirir.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Anlık Dublaj"
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "permissions": ["storage", "activeTab", "tabCapture", "offscreen", "tabs"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/overlay.js", "content/content.js"],
      "css": ["content/overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-translation": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Bu sekmede canlı çeviriyi aç/kapat"
    }
  }
}
